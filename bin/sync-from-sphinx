#!/usr/bin/env bash
# Derive lectures/ from the Sphinx corpus: copy the sources of
# test-lecture-theme-sphinx at a given checkout, apply the DECIDED source
# rewrites, and record where they came from.
#
#   bin/sync-from-sphinx <path-to-test-lecture-theme-sphinx> [<path-to-quantecon-theme.mystmd>]
#
# Rewrites applied (each one a recorded decision):
#   * `{raw}` blocks -- the notebook logo header is deleted, the Our World in
#     Data iframe becomes `{iframe}`, span tables are unfenced
#     (QuantEcon/quantecon-theme.mystmd#204; scripts/rewrite-raw-blocks.mjs
#     in the theme repository, pinned by the checkout you pass).
#   * the long-output rename -- every `output_scroll` and `scroll-output` tag
#     on a code cell becomes `collapse-output-24`, one for one (theme-parity
#     decision D15, QuantEcon/project-theme-parity#19; the cutover tooling of
#     QuantEcon/workspace-lectures#64 applies the same rename to the lectures).
#     Only a code cell's options are touched -- a `:tags:` line, or a `tags:`
#     key and its list items in the cell's `---` YAML block -- never prose.
#   * the plain-citation rename -- every `{cite}` role becomes `{cite:p}`, so a
#     citation stays parenthetical as sphinxcontrib-bibtex renders it, where
#     mystmd would make a plain `{cite}` narrative (theme-parity decision D16,
#     QuantEcon/project-theme-parity#37; at cutover `myst upgrade` applies the
#     same rule to the lectures, QuantEcon/mystmd#120). Only role uses in
#     prose and directive bodies are renamed: never inside a code fence, and
#     never `{cite}` written as inline code (a backtick before it).
#   * the `:hide-output: false` deletion -- the option is a no-op (the output
#     shows on both stacks) that the fork warns on, so it is removed from a
#     code cell's option block, as a `:hide-output:` line or a `hide-output:`
#     key in the `---` YAML block (QuantEcon/project-theme-parity SYNTAX.md;
#     `myst upgrade` does the same at cutover, QuantEcon/mystmd#120). Any
#     other value stops the sync: hiding an output is the `hide-output` tag's
#     job, and a person decides how to rewrite it.
#
# Everything else is copied as written, including the constructs the
# migration project has NOT yet decided (QuantEcon/workspace-lectures#64):
# `{only}`, `{youtube}`, `{glue:figure}`, `{nb-exec-table}`, `scroll-input`,
# `{prf:Theorem}`, `{any}` and `{todo}`. They stay so that the mystmd build
# shows what each one does today; a decision adds a rule here.
#
# Not copied: `_config.yml` and `_toc.yml` (myst.yml is written by hand) and
# `_static/includes/*.raw` (sphinx-tojupyter's notebook header; the mystmd
# header comes from a project setting once QuantEcon/mystmd#108 ships).
set -euo pipefail
SRC=${1:?path to a test-lecture-theme-sphinx checkout}
THEME=${2:-$(dirname "$0")/../../quantecon-theme.mystmd}
HERE="$(cd "$(dirname "$0")/.." && pwd)"
[ -f "$SRC/lectures/_toc.yml" ] || { echo "not a corpus checkout: $SRC" >&2; exit 2; }
[ -f "$THEME/scripts/rewrite-raw-blocks.mjs" ] || { echo "theme checkout without scripts/rewrite-raw-blocks.mjs: $THEME" >&2; exit 2; }

rm -rf "$HERE/lectures.new"; mkdir -p "$HERE/lectures.new"
tar -C "$SRC/lectures" --exclude=./_build --exclude=./_config.yml --exclude=./_toc.yml --exclude=./_static/includes -cf - . | tar -C "$HERE/lectures.new" -xf -
node "$THEME/scripts/rewrite-raw-blocks.mjs" "$HERE/lectures.new"
# D15: the long-output rename, inside code-cell option blocks only.
find "$HERE/lectures.new" -name '*.md' -print0 | xargs -0 perl -i -ne '
  BEGIN { $opts = 0; $yaml = 0; $intags = 0 }
  if (!$opts && /^\s*(`{3,}|~{3,})\{code-cell\}/) { $opts = 1; $yaml = 0; $intags = 0; print; next }
  if ($opts) {
    if (!$yaml && /^\s*---\s*$/) { $yaml = 1; print; next }
    if ($yaml && /^\s*---\s*$/) { $yaml = 0; $opts = 0; print; next }
    if ($yaml || /^\s*:[\w-]+:/) {
      if (/^\s*:?tags:?/) { s/(?<![\w-])(?:output_scroll|scroll-output)(?![\w-])/collapse-output-24/g; $intags = $yaml && /^\s*tags:\s*$/ ? 1 : 0 }
      elsif ($intags && /^\s*-\s/) { s/(?<![\w-])(?:output_scroll|scroll-output)(?![\w-])/collapse-output-24/g }
      else { $intags = 0 }
      print; next
    }
    $opts = 0; $intags = 0;
  }
  print;
  $opts = 0 if eof;
'
# D16: the plain-citation rename, outside code fences and inline code.
find "$HERE/lectures.new" -name '*.md' -print0 | xargs -0 perl -i -ne '
  BEGIN { @stack = () }
  if (/^\s*(`{3,}|~{3,})(.*)$/) {
    my ($f, $info) = ($1, $2);
    if (@stack && $info =~ /^\s*$/ && substr($f, 0, 1) eq substr($stack[-1][0], 0, 1) && length($f) >= length($stack[-1][0])) {
      pop @stack; print; next;
    }
    my $code = (@stack && $stack[-1][1])
      || $info !~ /^\s*\{/
      || $info =~ /^\s*\{(code-cell|code-block|code|sourcecode|literalinclude|math|raw|eval-rst|csv-table|glue|mermaid)\}/;
    push @stack, [$f, $code ? 1 : 0]; print; next;
  }
  s/(?<![`\w])\{cite\}(?=`[^`]+`)/{cite:p}/g unless @stack && $stack[-1][1];
  print;
  @stack = () if eof;
'
# The `:hide-output: false` deletion, inside code-cell option blocks only. When it was the
# cell's only option, the blank line that separated the options from the code goes too.
find "$HERE/lectures.new" -name '*.md' -print0 | xargs -0 perl -i -ne '
  BEGIN { $opts = 0; $yaml = 0; $kept = 0; $dropblank = 0 }
  if ($dropblank) { $dropblank = 0; next if /^\s*$/ }
  if (!$opts && /^\s*(`{3,}|~{3,})\{code-cell\}/) { $opts = 1; $yaml = 0; $kept = 0; print; next }
  if ($opts) {
    if (!$yaml && !$kept && /^\s*---\s*$/) { $yaml = 1; print; next }
    if ($yaml && /^\s*---\s*$/) { $yaml = 0; $opts = 0; print; next }
    if ($yaml ? /^\s*hide-output:\s*(.*?)\s*$/ : /^\s*:hide-output:\s*(.*?)\s*$/) {
      die "sync-from-sphinx: $ARGV:$.: hide-output is \"$1\", not false -- rewrite it by hand (a hide-output tag)\n" if $1 ne "false";
      $dropblank = 1 if !$yaml && !$kept;
      next;
    }
    if ($yaml || /^\s*:[\w-]+:/) { $kept = 1; print; next }
    $opts = 0;
  }
  print;
  if (eof) { $opts = 0; $yaml = 0; $kept = 0; $dropblank = 0; close ARGV }
'

src_sha=$(git -C "$SRC" rev-parse HEAD 2>/dev/null || echo unknown)
theme_sha=$(git -C "$THEME" rev-parse HEAD 2>/dev/null || echo unknown)
cat > "$HERE/lectures.new/SOURCE.yml" <<YAML
# Generated by bin/sync-from-sphinx -- do not edit lectures/ by hand.
source_repo: QuantEcon/test-lecture-theme-sphinx
source_commit: $src_sha
rewrite_script: QuantEcon/quantecon-theme.mystmd scripts/rewrite-raw-blocks.mjs
rewrite_script_commit: $theme_sha
synced: $(date -u +%Y-%m-%dT%H:%M:%SZ)
YAML
# keep the hand-written project files
for f in myst.yml; do [ -f "$HERE/lectures/$f" ] && cp "$HERE/lectures/$f" "$HERE/lectures.new/$f"; done
# keep the build cache and output (gitignored) across a sync
[ -d "$HERE/lectures/_build" ] && mv "$HERE/lectures/_build" "$HERE/lectures.new/_build"
rm -rf "$HERE/lectures"; mv "$HERE/lectures.new" "$HERE/lectures"
echo "synced lectures/ from $SRC @ ${src_sha:0:8} (rewrite script @ ${theme_sha:0:8})"
