#!/usr/bin/env bash
# Derive lectures/ from the Sphinx corpus: copy the sources of
# test-lecture-theme-sphinx at a given checkout, apply the DECIDED source
# rewrites, and record where they came from.
#
#   bin/sync-from-sphinx <path-to-test-lecture-theme-sphinx> [<path-to-quantecon-theme.mystmd>]
#
# Rewrites applied (each one a recorded decision):
#   * `{raw}` blocks -- the notebook logo header is deleted, the Our World in
#     Data iframe becomes `{iframe}`, span tables are unfenced
#     (QuantEcon/quantecon-theme.mystmd#204; scripts/rewrite-raw-blocks.mjs
#     in the theme repository, pinned by the checkout you pass).
#
# Everything else is copied as written, including the constructs the
# migration project has NOT yet decided (QuantEcon/workspace-lectures#64):
# `{only}`, `{youtube}`, `{glue:figure}`, `{nb-exec-table}`, the scroll tags,
# `{prf:Theorem}`, `{any}` and `{todo}`. They stay so that the mystmd build
# shows what each one does today; a decision adds a rule here.
#
# Not copied: `_config.yml` and `_toc.yml` (myst.yml is written by hand) and
# `_static/includes/*.raw` (sphinx-tojupyter's notebook header; the mystmd
# header comes from a project setting once QuantEcon/mystmd#108 ships).
set -euo pipefail
SRC=${1:?path to a test-lecture-theme-sphinx checkout}
THEME=${2:-$(dirname "$0")/../../quantecon-theme.mystmd}
HERE="$(cd "$(dirname "$0")/.." && pwd)"
[ -f "$SRC/lectures/_toc.yml" ] || { echo "not a corpus checkout: $SRC" >&2; exit 2; }
[ -f "$THEME/scripts/rewrite-raw-blocks.mjs" ] || { echo "theme checkout without scripts/rewrite-raw-blocks.mjs: $THEME" >&2; exit 2; }

rm -rf "$HERE/lectures.new"; mkdir -p "$HERE/lectures.new"
tar -C "$SRC/lectures" --exclude=./_build --exclude=./_config.yml --exclude=./_toc.yml --exclude=./_static/includes -cf - . | tar -C "$HERE/lectures.new" -xf -
node "$THEME/scripts/rewrite-raw-blocks.mjs" "$HERE/lectures.new"

src_sha=$(git -C "$SRC" rev-parse HEAD 2>/dev/null || echo unknown)
theme_sha=$(git -C "$THEME" rev-parse HEAD 2>/dev/null || echo unknown)
cat > "$HERE/lectures.new/SOURCE.yml" <<YAML
# Generated by bin/sync-from-sphinx -- do not edit lectures/ by hand.
source_repo: QuantEcon/test-lecture-theme-sphinx
source_commit: $src_sha
rewrite_script: QuantEcon/quantecon-theme.mystmd scripts/rewrite-raw-blocks.mjs
rewrite_script_commit: $theme_sha
synced: $(date -u +%Y-%m-%dT%H:%M:%SZ)
YAML
# keep the hand-written project files
for f in myst.yml; do [ -f "$HERE/lectures/$f" ] && cp "$HERE/lectures/$f" "$HERE/lectures.new/$f"; done
# keep the build cache and output (gitignored) across a sync
[ -d "$HERE/lectures/_build" ] && mv "$HERE/lectures/_build" "$HERE/lectures.new/_build"
rm -rf "$HERE/lectures"; mv "$HERE/lectures.new" "$HERE/lectures"
echo "synced lectures/ from $SRC @ ${src_sha:0:8} (rewrite script @ ${theme_sha:0:8})"
